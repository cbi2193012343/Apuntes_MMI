\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Retrato fase del sistema mutualista fuerte. Las isoclinas $x=2+2y$ (rojo) e $y=2+2x$ (verde) no se cortan en el primer cuadrante. Las trayectorias interiores se alejan hacia el noreste de forma no acotada.}}{3}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Retrato fase del sistema mutualista regulado. Las isoclinas $y=2x-2$ (rojo) e $y=(x+2)/2$ (verde) se cortan en $(2,2)$, nodo sumidero estable. Toda trayectoria interior converge a ese punto.}}{6}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Retrato fase del sistema de competencia. Las isoclinas $x+2y=2$ (rojo) y $2x+y=2$ (verde) se cortan en el punto silla $(\frac  {2}{3},\frac  {2}{3})$. La diagonal $y=x$ (punteada) actúa como separatriz entre las cuencas de atracción de $(2,0)$ y $(0,2)$.}}{9}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Retrato fase del Problema~1. Las dos rectas isoclinas se cruzan en el punto silla $(3,1)$.}}{11}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Retrato fase del Problema~2. Las isoclinas $y=1$ (rojo) y $x=2$ (verde) se cortan en el centro $(2,1)$; las trayectorias describen órbitas cerradas en torno a él.}}{12}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Retrato fase del Problema~3. La parábola $y=x^2$ (rojo, isoclina de $x$) y la parábola acostada $x=-y^2$ (verde, isoclina de $y$) se cortan en $(0,0)$ y $(-1,1)$.}}{13}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Retrato fase del Problema~4. La recta $x+y=1$ (rojo) y la recta $x=2$ (verde) no se intersectan en el primer cuadrante: la nullclina $x=2$ queda inalcanzable para las trayectorias biológicas.}}{14}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Retrato fase del Problema~5. Aunque la linealización predice un centro, el análisis en polares revela un foco inestable: las trayectorias espiralan hacia afuera y escapan en tiempo finito.}}{15}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Retrato fase del Problema~6 con $\alpha =\beta =\gamma =\delta =1$. El equilibrio interior $(1,1)$ es un centro rodeado por órbitas cerradas; el origen es silla.}}{17}{}\protected@file@percent }
